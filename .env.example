# =========================================================
# Gemini API Configuration
# =========================================================
# ใส่ API Key ที่ได้จาก Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================================
# App Configuration (Optional / Default Parameters)
# =========================================================
# โมเดล Gemini ที่ใช้งาน (ค่าเริ่มต้น: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Temperature สำหรับการประมวลผลทางบัญชี (ค่าเริ่มต้น: 0.1)
# DEFAULT_TEMPERATURE=0.1